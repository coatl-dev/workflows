{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":semanticCommitTypeAll(refactor)"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "ignorePaths": [
    ".github/workflows/bump.yml",
    ".github/workflows/release.yml"
  ]
}
